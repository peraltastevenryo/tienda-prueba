# Copia este archivo como .env y reemplaza con TUS datos de Neon
# (Neon -> Connect -> desactivar Connection pooling -> "Parameters only").
#   DB_URL      = jdbc:postgresql:// + PGHOST + / + PGDATABASE + ?sslmode=require
#   DB_USERNAME = PGUSER
#   DB_PASSWORD = PGPASSWORD
# Sin comillas y sin espacios alrededor del "=".
DB_URL=jdbc:postgresql://ep-xxxx-xxxx.c-2.sa-east-1.aws.neon.tech/neondb?sslmode=require
DB_USERNAME=neondb_owner
DB_PASSWORD=tu_password
